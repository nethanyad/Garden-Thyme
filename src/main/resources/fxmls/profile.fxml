<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="primaryPane" maxWidth="-Infinity" minHeight="730.0" minWidth="400.0" prefHeight="730.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gardenthyme.gui.controllers.Profile">
    <children>
        <VBox fx:id="baseVBox" alignment="TOP_CENTER" prefHeight="200.0" prefWidth="400.0">
            <children>
                <HBox fx:id="titleBar" alignment="CENTER" maxWidth="-Infinity" prefHeight="60.0" prefWidth="400.0" spacing="20.0">
                    <children>
                  <Button fx:id="adminModeButton" mnemonicParsing="false" text="Admin Mode" />
                        <Label fx:id="title" text="Your Gardens">
                            <font>
                                <Font name="Forte" size="33.0" />
                            </font>
                        </Label>
                  <Button fx:id="logoutButton" mnemonicParsing="false" text="Log Out" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </HBox>
                <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" minWidth="300.0" prefHeight="200.0" prefWidth="200.0" vbarPolicy="NEVER">
                    <content>
                        <VBox fx:id="contentVBox" alignment="TOP_CENTER" prefWidth="100.0" spacing="10.0" />
                    </content>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
